[Unit]
Description=TUA Teltonika firmware and config keeper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rutkeeper
Group=rutkeeper
WorkingDirectory=/opt/rutkeeper
Environment=RUTKEEPER_DATA=/var/lib/rutkeeper
Environment=RUTKEEPER_FILES=/boot/firmware
Environment=RUTKEEPER_HOST=0.0.0.0
Environment=RUTKEEPER_PORT=8741
Environment=RUTKEEPER_TLS=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rutkeeper/.venv/bin/python -m rutkeeper
Restart=on-failure
RestartSec=3
# RMS installs a source route around the bench cable. NoNewPrivileges blocks that.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/rutkeeper
UMask=0077

[Install]
WantedBy=multi-user.target
